---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Sobre la boticaria";

const identity = {
  firstName: "Mery",
  country: "México",
  occupation: "estudiante de Desarrollo de Software en el CETI",
  hobbies: ["ver anime", "resolver misterios como Maomao", "programar"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Python", "Encontrar venenos en el código"];

const happy = true;
const finished = true;
const goal = 3;
const skillColor = "#b8a4e3";
const fontWeight = "bold";
const textCase = "uppercase";
---
<BaseLayout pageTitle={pageTitle}>
  <h2>¡Hola! Soy {identity.firstName}, la boticaria de este sitio.</h2>

  <p>Igual que Maomao analiza cada hierba antes de usarla, yo voy probando cada parte del tutorial de Astro.</p>
  <p>Este sitio se irá actualizando conforme avance, ¡así que vuelve pronto al palacio!</p>

  <div class="tarjeta">
    <h3>Datos de la boticaria</h3>
    <ul>
      <li>Me llamo {identity.firstName}.</li>
      <li>Vivo en {identity.country} y soy {identity.occupation}.</li>
      {identity.hobbies.length >= 2 &&
        <li>Dos de mis aficiones son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
      }
    </ul>
  </div>

  <h3>Mis habilidades de boticaria</h3>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {happy && <p>¡Estoy feliz de aprender Astro!</p>}
  {finished && <p>¡He terminado este tutorial! El diario de la boticaria está completo.</p>}
  {goal === 3 ? <p>Mi objetivo es terminar en 3 días.</p> : <p>Mi objetivo no son 3 días.</p>}
</BaseLayout>

<style define:vars={{ skillColor, fontWeight, textCase }}>
  .skill {
    color: var(--skillColor);
    font-weight: var(--fontWeight);
    text-transform: var(--textCase);
  }
</style>